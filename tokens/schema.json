{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harpia token catalog",
  "oneOf": [
    { "$ref": "#/$defs/palette" },
    { "$ref": "#/$defs/theme" },
    { "$ref": "#/$defs/dimensions" },
    { "$ref": "#/$defs/typography" },
    { "$ref": "#/$defs/effects" }
  ],
  "$defs": {
    "shadow": {
      "type": ["object", "null"],
      "required": ["x", "y", "blur", "spread", "color"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "blur": { "type": "number", "minimum": 0 },
        "spread": { "type": "number" },
        "color": { "type": "string", "pattern": "^rgba\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}, (0|1|0\\.[0-9]+)\\)$" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["kind", "source", "layers", "shadows"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "effects" },
        "source": { "type": "string" },
        "layers": {
          "type": "array",
          "prefixItems": [
            { "const": "card" }, { "const": "popover" }, { "const": "backdrop" },
            { "const": "dialog" }, { "const": "tooltip" }, { "const": "toast" }
          ],
          "minItems": 6,
          "maxItems": 6
        },
        "shadows": {
          "type": "object",
          "required": ["card", "popover", "dialog", "tooltip"],
          "properties": {
            "card": { "$ref": "#/$defs/shadowThemes" },
            "popover": { "$ref": "#/$defs/shadowThemes" },
            "dialog": { "$ref": "#/$defs/shadowThemes" },
            "tooltip": { "$ref": "#/$defs/shadowThemes" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shadowThemes": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": { "light": { "$ref": "#/$defs/shadow" }, "dark": { "$ref": "#/$defs/shadow" } },
      "additionalProperties": false
    },
    "colorValue": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|rgba\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}, (0|1|0\\.[0-9]+)\\)|\\{color\\.[A-Za-z0-9.]+\\})$"
    },
    "colors": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^color\\.[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)*$": { "$ref": "#/$defs/colorValue" }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": ["kind", "source", "colors"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "palette" },
        "source": { "type": "string" },
        "colors": { "$ref": "#/$defs/colors" }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["kind", "name", "source", "colors"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "theme" },
        "name": { "enum": ["light", "dark"] },
        "source": { "type": "string" },
        "colors": { "$ref": "#/$defs/colors" }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": ["kind", "source", "unit", "values"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "dimensions" },
        "source": { "type": "string" },
        "unit": { "const": "reference-px-at-16px-root" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(spacing|size|radius)\\.[A-Za-z0-9][A-Za-z0-9.-]*$": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["kind", "family", "source", "sizeUnit", "sizes", "weights", "lineHeights", "roles"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "typography" },
        "family": { "const": "Montserrat" },
        "source": { "type": "string" },
        "sizeUnit": { "const": "reference-px-at-16px-root" },
        "sizes": { "$ref": "#/$defs/typographySizes" },
        "weights": { "$ref": "#/$defs/typographyWeights" },
        "lineHeights": { "$ref": "#/$defs/typographyLineHeights" },
        "roles": { "$ref": "#/$defs/typographyRoles" }
      },
      "additionalProperties": false
    },
    "typographySizes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": { "^[2-6]?(xs|xl)$|^(sm|md|base|lg)$": { "type": "number", "exclusiveMinimum": 0 } },
      "additionalProperties": false
    },
    "typographyWeights": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": { "^(regular|medium|semibold|bold|extrabold)$": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 } },
      "additionalProperties": false
    },
    "typographyLineHeights": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": { "^(none|tight|snug|normal|relaxed|loose)$": { "type": "number", "exclusiveMinimum": 0 } },
      "additionalProperties": false
    },
    "typographyRoles": {
      "type": "object",
      "required": ["pageTitle", "sectionTitle", "componentTitle", "body", "supporting", "controlLabel"],
      "properties": {
        "pageTitle": { "$ref": "#/$defs/typographyRole" },
        "sectionTitle": { "$ref": "#/$defs/typographyRole" },
        "componentTitle": { "$ref": "#/$defs/typographyRole" },
        "body": { "$ref": "#/$defs/typographyRole" },
        "supporting": { "$ref": "#/$defs/typographyRole" },
        "controlLabel": { "$ref": "#/$defs/typographyRole" }
      },
      "additionalProperties": false
    },
    "typographyRole": {
      "type": "object",
      "required": ["size", "weight", "lineHeight", "letterSpacing"],
      "properties": {
        "size": { "type": "string" },
        "weight": { "type": "string" },
        "lineHeight": { "type": "string" },
        "letterSpacing": { "const": 0 }
      },
      "additionalProperties": false
    }
  }
}
