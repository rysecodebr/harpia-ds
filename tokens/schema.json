{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harpia color token catalog",
  "oneOf": [
    { "$ref": "#/$defs/palette" },
    { "$ref": "#/$defs/theme" },
    { "$ref": "#/$defs/dimensions" }
  ],
  "$defs": {
    "colorValue": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|rgba\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}, (0|1|0\\.[0-9]+)\\)|\\{color\\.[A-Za-z0-9.]+\\})$"
    },
    "colors": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^color\\.[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)*$": { "$ref": "#/$defs/colorValue" }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": ["kind", "source", "colors"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "palette" },
        "source": { "type": "string" },
        "colors": { "$ref": "#/$defs/colors" }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["kind", "name", "source", "colors"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "theme" },
        "name": { "enum": ["light", "dark"] },
        "source": { "type": "string" },
        "colors": { "$ref": "#/$defs/colors" }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": ["kind", "source", "unit", "values"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "dimensions" },
        "source": { "type": "string" },
        "unit": { "const": "reference-px-at-16px-root" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(spacing|size|radius)\\.[A-Za-z0-9][A-Za-z0-9.-]*$": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
